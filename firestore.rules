rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/invites/$(inviteId);
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function myCompanyId() {
      return signedIn() ? myProfile().companyId : null;
    }

    function isManager() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && myProfile().role == 'manager'
        && myProfile().status == 'active';
    }

    function validAssignee(assigneeId, companyId) {
      return assigneeId == null
        || (
          assigneeId is string
          && exists(profilePath(assigneeId))
          && get(profilePath(assigneeId)).data.companyId == companyId
          && get(profilePath(assigneeId)).data.status == 'active'
        );
    }

    function validTaskStatus(status) {
      return status in [
        'Not started',
        'In progress',
        'Submitted',
        'Approved',
        'Needs correction'
      ];
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid
        || (isManager() && resource.data.companyId == myCompanyId())
      );

      allow list: if isManager()
        && resource.data.companyId == myCompanyId();

      allow create: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.role == 'manager'
          && request.resource.data.status == 'active'
          && request.resource.data.companyId is string
          && request.resource.data.fullName is string
          && request.resource.data.email is string
          && exists(companyPath(request.resource.data.companyId))
          && get(companyPath(request.resource.data.companyId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'fullName', 'email', 'companyId', 'role',
            'team', 'status', 'createdAt'
          ])
        )
        ||
        (
          request.auth.uid == uid
          && request.resource.data.role == 'employee'
          && request.resource.data.status == 'active'
          && request.resource.data.companyId is string
          && request.resource.data.fullName is string
          && request.resource.data.email is string
          && request.resource.data.inviteId is string
          && exists(invitePath(request.resource.data.inviteId))
          && get(invitePath(request.resource.data.inviteId)).data.status == 'pending'
          && get(invitePath(request.resource.data.inviteId)).data.companyId == request.resource.data.companyId
          && get(invitePath(request.resource.data.inviteId)).data.email == request.auth.token.email.lower()
          && get(invitePath(request.resource.data.inviteId)).data.expiresAt > request.time
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.team == get(invitePath(request.resource.data.inviteId)).data.team
          && request.resource.data.keys().hasOnly([
            'fullName', 'email', 'companyId', 'role',
            'team', 'status', 'inviteId', 'createdAt'
          ])
        )
      );

      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['fullName'])
        )
        ||
        (
          isManager()
          && uid != request.auth.uid
          && resource.data.companyId == myCompanyId()
          && request.resource.data.companyId == resource.data.companyId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['fullName', 'team', 'status'])
          && request.resource.data.status in ['active', 'inactive']
        )
      );

      allow delete: if isManager()
        && uid != request.auth.uid
        && resource.data.companyId == myCompanyId();
    }

    match /companies/{companyId} {
      allow get: if signedIn() && companyId == myCompanyId();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'createdAt'
        ]);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string;

      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow create: if isManager()
        && request.resource.data.companyId == myCompanyId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.team is string
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.keys().hasOnly([
          'companyId', 'email', 'team', 'createdBy',
          'status', 'createdAt', 'expiresAt'
        ]);

      allow get: if (
        isManager() && resource.data.companyId == myCompanyId()
      ) || (
        signedIn()
        && resource.data.email == request.auth.token.email.lower()
      );

      allow list: if isManager()
        && resource.data.companyId == myCompanyId();

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedBy', 'acceptedAt'
        ])
        && getAfter(profilePath(request.auth.uid)).data.inviteId == inviteId
        && getAfter(profilePath(request.auth.uid)).data.companyId == resource.data.companyId
        && getAfter(profilePath(request.auth.uid)).data.role == 'employee';

      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow get, list: if signedIn()
        && resource.data.companyId == myCompanyId()
        && (
          isManager()
          || resource.data.assigneeId == request.auth.uid
        );

      allow create: if isManager()
        && request.resource.data.companyId == myCompanyId()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && validTaskStatus(request.resource.data.status)
        && validAssignee(request.resource.data.assigneeId, myCompanyId())
        && request.resource.data.keys().hasOnly([
          'companyId', 'createdBy', 'title', 'assigneeId',
          'assigneeName', 'dueDate', 'priority', 'status',
          'description', 'checklist', 'evidence', 'activity',
          'createdAt', 'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.companyId == myCompanyId()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (
            isManager()
            && validAssignee(request.resource.data.assigneeId, myCompanyId())
            && validTaskStatus(request.resource.data.status)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'assigneeId', 'assigneeName', 'dueDate',
              'priority', 'status', 'description', 'checklist',
              'evidence', 'activity', 'notes', 'updatedAt'
            ])
          )
          ||
          (
            resource.data.assigneeId == request.auth.uid
            && request.resource.data.assigneeId == resource.data.assigneeId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'notes', 'checklist', 'status', 'activity', 'updatedAt'
            ])
            && (
              request.resource.data.status == resource.data.status
              || request.resource.data.status == 'Submitted'
            )
          )
        );

      allow delete: if isManager()
        && resource.data.companyId == myCompanyId();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
